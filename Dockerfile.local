# Local runtime derivative for a pinned official LibreChat release.
# It overlays the local model-discovery and client gating changes, then rebuilds
# only the affected data-schemas, API, data-provider, and browser bundles.
ARG LIBRECHAT_BASE_IMAGE=librechat/librechat:v0.8.7@sha256:a950bb5fe847ae3b00797bf02d0b26bcd4c12f27240ebad6fa9eedafefc59d52
FROM ${LIBRECHAT_BASE_IMAGE}

ARG LIBRECHAT_VERSION=v0.8.7.10
LABEL org.opencontainers.image.version="${LIBRECHAT_VERSION}"

USER root
COPY --chown=node:node scripts/langchain/patch.cjs /tmp/librechat-patches/langchain/patch.cjs
COPY --chown=node:node scripts/langchain/verify.cjs /tmp/librechat-patches/langchain/verify.cjs
COPY --chown=node:node api/server/services/Config/loadDefaultModels.js /app/api/server/services/Config/loadDefaultModels.js
COPY --chown=node:node api/server/controllers/ModelController.js /app/api/server/controllers/ModelController.js
COPY --chown=node:node api/server/routes/lihe.js /app/api/server/routes/lihe.js
COPY --chown=node:node api/server/routes/auth.js /app/api/server/routes/auth.js
COPY --chown=node:node api/server/routes/config.js /app/api/server/routes/config.js
COPY --chown=node:node api/server/routes/oauth.js /app/api/server/routes/oauth.js
COPY --chown=node:node api/server/routes/index.js /app/api/server/routes/index.js
COPY --chown=node:node api/server/socialLogins.js /app/api/server/socialLogins.js
COPY --chown=node:node api/server/controllers/UserController.js /app/api/server/controllers/UserController.js
COPY --chown=node:node api/strategies/openidStrategy.js /app/api/strategies/openidStrategy.js
COPY --chown=node:node api/server/index.js /app/api/server/index.js
COPY --chown=node:node api/server/experimental.js /app/api/server/experimental.js
COPY --chown=node:node packages/api/src/endpoints/models.ts /app/packages/api/src/endpoints/models.ts
COPY --chown=node:node packages/api/src/endpoints/config/models.ts /app/packages/api/src/endpoints/config/models.ts
COPY --chown=node:node packages/api/src/index.ts /app/packages/api/src/index.ts
COPY --chown=node:node packages/api/src/auth/index.ts /app/packages/api/src/auth/index.ts
COPY --chown=node:node packages/api/src/auth/openidAccess.ts /app/packages/api/src/auth/openidAccess.ts
COPY --chown=node:node packages/api/src/auth/link.ts /app/packages/api/src/auth/link.ts
COPY --chown=node:node packages/api/src/lihe/client.ts /app/packages/api/src/lihe/client.ts
COPY --chown=node:node packages/api/src/lihe/config.ts /app/packages/api/src/lihe/config.ts
COPY --chown=node:node packages/api/src/lihe/handlers.ts /app/packages/api/src/lihe/handlers.ts
COPY --chown=node:node packages/api/src/lihe/index.ts /app/packages/api/src/lihe/index.ts
COPY --chown=node:node packages/api/src/lihe/security.ts /app/packages/api/src/lihe/security.ts
COPY --chown=node:node packages/api/src/lihe/storage.ts /app/packages/api/src/lihe/storage.ts
COPY --chown=node:node packages/api/src/oauth/callback.ts /app/packages/api/src/oauth/callback.ts
COPY --chown=node:node packages/api/src/utils/oidc.ts /app/packages/api/src/utils/oidc.ts
COPY --chown=node:node packages/data-schemas/src/types/index.ts /app/packages/data-schemas/src/types/index.ts
COPY --chown=node:node packages/data-schemas/src/types/openid.ts /app/packages/data-schemas/src/types/openid.ts
COPY --chown=node:node packages/data-schemas/src/schema/index.ts /app/packages/data-schemas/src/schema/index.ts
COPY --chown=node:node packages/data-schemas/src/schema/openid/tombstone.ts /app/packages/data-schemas/src/schema/openid/tombstone.ts
COPY --chown=node:node packages/data-schemas/src/models/index.ts /app/packages/data-schemas/src/models/index.ts
COPY --chown=node:node packages/data-schemas/src/models/openid/tombstone.ts /app/packages/data-schemas/src/models/openid/tombstone.ts
COPY --chown=node:node packages/data-schemas/src/methods/index.ts /app/packages/data-schemas/src/methods/index.ts
COPY --chown=node:node packages/data-schemas/src/methods/openid.ts /app/packages/data-schemas/src/methods/openid.ts
COPY --chown=node:node packages/data-provider/src/api-endpoints.ts /app/packages/data-provider/src/api-endpoints.ts
COPY --chown=node:node packages/data-provider/src/config.ts /app/packages/data-provider/src/config.ts
COPY --chown=node:node packages/data-provider/src/data-service.ts /app/packages/data-provider/src/data-service.ts
COPY --chown=node:node packages/data-provider/src/keys.ts /app/packages/data-provider/src/keys.ts
COPY --chown=node:node packages/data-provider/src/models.ts /app/packages/data-provider/src/models.ts
COPY --chown=node:node packages/data-provider/src/schemas.ts /app/packages/data-provider/src/schemas.ts
COPY --chown=node:node packages/data-provider/src/types.ts /app/packages/data-provider/src/types.ts
COPY --chown=node:node packages/data-provider/src/types/lihe.ts /app/packages/data-provider/src/types/lihe.ts
COPY --chown=node:node packages/data-provider/src/parameterSettings.ts /app/packages/data-provider/src/parameterSettings.ts
COPY --chown=node:node client/src/data-provider/index.ts /app/client/src/data-provider/index.ts
COPY --chown=node:node client/src/data-provider/Lihe/index.ts /app/client/src/data-provider/Lihe/index.ts
COPY --chown=node:node client/src/data-provider/Lihe/mutations.ts /app/client/src/data-provider/Lihe/mutations.ts
COPY --chown=node:node client/src/data-provider/Lihe/queries.ts /app/client/src/data-provider/Lihe/queries.ts
COPY --chown=node:node client/src/components/Lihe/Connect.tsx /app/client/src/components/Lihe/Connect.tsx
COPY --chown=node:node client/src/components/Lihe/ConnectionRow.tsx /app/client/src/components/Lihe/ConnectionRow.tsx
COPY --chown=node:node client/src/components/Lihe/AccountLinkResult.tsx /app/client/src/components/Lihe/AccountLinkResult.tsx
COPY --chown=node:node client/src/components/Lihe/index.ts /app/client/src/components/Lihe/index.ts
COPY --chown=node:node client/src/components/Nav/SettingsTabs/Account/OpenIdAccountLink.tsx /app/client/src/components/Nav/SettingsTabs/Account/OpenIdAccountLink.tsx
COPY --chown=node:node client/src/components/Nav/SettingsTabs/ProviderKeys/ProviderKeys.tsx /app/client/src/components/Nav/SettingsTabs/ProviderKeys/ProviderKeys.tsx
COPY --chown=node:node client/src/components/Nav/Settings/context.tsx /app/client/src/components/Nav/Settings/context.tsx
COPY --chown=node:node client/src/components/Nav/Settings/registry.tsx /app/client/src/components/Nav/Settings/registry.tsx
COPY --chown=node:node client/src/components/Nav/Settings/types.ts /app/client/src/components/Nav/Settings/types.ts
COPY --chown=node:node client/src/data-provider/Auth/mutations.ts /app/client/src/data-provider/Auth/mutations.ts
COPY --chown=node:node client/src/routes/index.tsx /app/client/src/routes/index.tsx
COPY --chown=node:node client/src/hooks/Endpoint/useEndpoints.ts /app/client/src/hooks/Endpoint/useEndpoints.ts
COPY --chown=node:node client/src/components/SidePanel/Parameters/DynamicDropdown.tsx /app/client/src/components/SidePanel/Parameters/DynamicDropdown.tsx
COPY --chown=node:node client/src/components/SidePanel/Parameters/Panel.tsx /app/client/src/components/SidePanel/Parameters/Panel.tsx
COPY --chown=node:node client/src/components/Chat/Input/ChatForm.tsx /app/client/src/components/Chat/Input/ChatForm.tsx
COPY --chown=node:node client/src/components/Chat/Input/ReasoningEffortControl.tsx /app/client/src/components/Chat/Input/ReasoningEffortControl.tsx
COPY --chown=node:node client/src/locales/en/translation.json /app/client/src/locales/en/translation.json
COPY --chown=node:node client/src/locales/zh-Hans/translation.json /app/client/src/locales/zh-Hans/translation.json
COPY --chown=node:node client/public/assets/grok.svg /app/client/public/assets/grok.svg

USER node
WORKDIR /app
RUN ( node -e 'const fs = require("fs"); const path = "/app/package.json"; const version = process.argv[1]; if (!/^v[0-9]+\.[0-9]+\.[0-9]+\.[1-9][0-9]*$/.test(version)) throw new Error("Invalid LibreChat local version"); const pkg = JSON.parse(fs.readFileSync(path, "utf8")); pkg.version = version; fs.writeFileSync(path, JSON.stringify(pkg, null, 2) + "\n");' "$LIBRECHAT_VERSION" \
  && node /tmp/librechat-patches/langchain/patch.cjs \
  && node /tmp/librechat-patches/langchain/verify.cjs \
  && mkdir -p /tmp/librechat-build /app/client/node_modules/@vitejs /app/client/node_modules/@tanstack /app/packages/client/node_modules /app/packages/data-provider/node_modules/@rollup /app/packages/data-provider/node_modules/@types /app/packages/data-schemas/node_modules \
  && npm install --prefix /tmp/librechat-build --no-save --ignore-scripts --package-lock=false \
    --fetch-retries=5 --fetch-retry-mintimeout=15000 --fetch-retry-maxtimeout=600000 \
    tsdown@0.22.2 \
    @rollup/plugin-replace@5.0.5 \
    @types/js-yaml@4.0.9 \
    openapi-types@12.1.3 \
    vite@8.0.16 \
    @vitejs/plugin-react@6.0.2 \
    vite-plugin-pwa@1.3.0 \
    vite-plugin-compression2@2.5.3 \
    vite-plugin-node-polyfills@0.28.0 \
    autoprefixer@10.4.20 \
    postcss-preset-env@11.2.0 \
    @tanstack/react-query-devtools@4.29.0 \
  && ln -s /tmp/librechat-build/node_modules/vite /app/client/node_modules/vite \
  && ln -s /tmp/librechat-build/node_modules/@vitejs/plugin-react /app/client/node_modules/@vitejs/plugin-react \
  && ln -s /tmp/librechat-build/node_modules/vite-plugin-pwa /app/client/node_modules/vite-plugin-pwa \
  && ln -s /tmp/librechat-build/node_modules/vite-plugin-compression2 /app/client/node_modules/vite-plugin-compression2 \
  && ln -s /tmp/librechat-build/node_modules/vite-plugin-node-polyfills /app/client/node_modules/vite-plugin-node-polyfills \
  && ln -s /tmp/librechat-build/node_modules/autoprefixer /app/client/node_modules/autoprefixer \
  && ln -s /tmp/librechat-build/node_modules/postcss-preset-env /app/client/node_modules/postcss-preset-env \
  && ln -s /tmp/librechat-build/node_modules/@tanstack/react-query-devtools /app/client/node_modules/@tanstack/react-query-devtools \
  && ln -s /app/client/node_modules/lucide-react /app/packages/client/node_modules/lucide-react \
  && ln -s /tmp/librechat-build/node_modules/tsdown /app/packages/data-provider/node_modules/tsdown \
  && ln -s /tmp/librechat-build/node_modules/tsdown /app/packages/data-schemas/node_modules/tsdown \
  && ln -s /tmp/librechat-build/node_modules/tsdown /app/packages/api/node_modules/tsdown \
  && ln -s /tmp/librechat-build/node_modules/@rollup/plugin-replace /app/packages/data-provider/node_modules/@rollup/plugin-replace \
  && ln -s /tmp/librechat-build/node_modules/@types/js-yaml /app/packages/data-provider/node_modules/@types/js-yaml \
  && ln -s /tmp/librechat-build/node_modules/openapi-types /app/packages/data-provider/node_modules/openapi-types \
  && rm -rf /app/packages/data-provider/dist \
  && cd /app/packages/data-provider \
  && /tmp/librechat-build/node_modules/.bin/tsdown \
  && /app/node_modules/.bin/tsc -p tsconfig.build.json \
  && rm -rf /app/packages/data-schemas/dist \
  && cd /app/packages/data-schemas \
  && /tmp/librechat-build/node_modules/.bin/tsdown \
  && rm -rf /app/packages/api/dist \
  && cd /app/packages/api \
  && /tmp/librechat-build/node_modules/.bin/tsdown \
  && cd /app/client \
  && NODE_OPTIONS=--max-old-space-size=768 /tmp/librechat-build/node_modules/.bin/vite build \
  && cp -R public/assets dist/assets \
  && cp public/robots.txt dist/robots.txt \
  && rm -f /app/client/node_modules/vite \
    /app/client/node_modules/@vitejs/plugin-react \
    /app/client/node_modules/vite-plugin-pwa \
    /app/client/node_modules/vite-plugin-compression2 \
    /app/client/node_modules/vite-plugin-node-polyfills \
    /app/client/node_modules/autoprefixer \
    /app/client/node_modules/postcss-preset-env \
    /app/client/node_modules/@tanstack/react-query-devtools \
    /app/packages/client/node_modules/lucide-react \
    /app/packages/data-provider/node_modules/tsdown \
    /app/packages/data-schemas/node_modules/tsdown \
    /app/packages/api/node_modules/tsdown \
    /app/packages/data-provider/node_modules/@rollup/plugin-replace \
    /app/packages/data-provider/node_modules/@types/js-yaml \
    /app/packages/data-provider/node_modules/openapi-types \
  && rm -rf /tmp/librechat-build /tmp/librechat-patches \
  ) > /tmp/librechat-local-build.log 2>&1 \
  && rm -f /tmp/librechat-local-build.log \
  || { status=$?; cat /tmp/librechat-local-build.log; exit "$status"; }

WORKDIR /app
