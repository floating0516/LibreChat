# This file is a template. scripts/prepare.sh writes .env with fresh secrets.
# It deliberately contains no provider API key.

LIBRECHAT_IMAGE=__LIBRECHAT_BASE_IMAGE__
ADMIN_PANEL_IMAGE=ghcr.io/clickhouse/librechat-admin-panel@sha256:1d3916ae84439e83da83507afd4aae14a99bd81ff2e1890079f57d8d377eb8e9

HOST=127.0.0.1
PORT=3080
APP_TITLE=ToCreate

# Local-only verification mode. Run scripts/enable-public-domain.sh only after
# the external tunnel and DNS are ready.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
PUBLIC_DOMAIN=chat.lihe.chat
CUSTOM_FOOTER=[ToCreate](https://api.lihe.chat) | Powered by [LibreChat __LIBRECHAT_DISPLAY_VERSION__](https://github.com/floating0516/LibreChat)
SESSION_COOKIE_SECURE=false
TRUST_PROXY=0
ADMIN_PANEL_URL=http://localhost:3000
ADMIN_PANEL_SESSION_SECRET=__ADMIN_PANEL_SESSION_SECRET__

MONGO_ROOT_USER=librechat
MONGO_ROOT_PASSWORD=__MONGO_ROOT_PASSWORD__

# Users enter separate keys for OpenAI, Gemini, Claude, and Grok in LibreChat's API-key settings.
ENDPOINTS=openAI,google,anthropic
OPENAI_API_KEY=user_provided
OPENAI_REVERSE_PROXY=https://api.lihe.chat/v1
GOOGLE_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
ANTHROPIC_REVERSE_PROXY=https://api.lihe.chat/v1

# Each user supplies a Tavily key in Web Search settings; never place a shared paid key here.
TAVILY_API_KEY=user_provided

# One-click Lihe API account connection. Keep disabled until api.lihe.chat implements
# LIHE_CONNECT_PROTOCOL.zh-CN.md and a client secret has been configured on both servers.
LIHE_CONNECT_ENABLED=false
LIHE_CONNECT_API_BASE_URL=https://api.lihe.chat
LIHE_CONNECT_CLIENT_ID=lihe-chat
LIHE_CONNECT_CLIENT_SECRET=
LIHE_CONNECT_PROVIDERS=openAI,anthropic,grok
LIHE_CONNECT_REQUIRE_OPENID_SUBJECT=false

# Unified Lihe account login and existing-account linking. Keep ALLOW_SOCIAL_LOGIN,
# ALLOW_SOCIAL_REGISTRATION, and OPENID_ACCOUNT_LINKING_ENABLED disabled until Discovery, JWKS,
# both redirect URIs, and the lihe-chat-login client secret pass integration testing.
OPENID_CLIENT_ID=lihe-chat-login
OPENID_CLIENT_SECRET=
OPENID_ISSUER=https://api.lihe.chat
OPENID_SESSION_SECRET=__OPENID_SESSION_SECRET__
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OPENID_USE_PKCE=true
OPENID_GENERATE_NONCE=true
OPENID_REUSE_TOKENS=false
OPENID_ACCOUNT_LINKING_ENABLED=false
OPENID_HIDDEN_TEST_MODE=false
OPENID_HIDDEN_TEST_ALLOWED_EMAILS=

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
MIN_PASSWORD_LENGTH=10
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=1000 * 60 * 60 * 24

SEARCH=false
NO_INDEX=true
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
LOG_TO_FILE=true
CONFIG_PATH=/app/librechat.yaml
NODE_OPTIONS=--max-old-space-size=768

JWT_SECRET=__JWT_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
CREDS_KEY=__CREDS_KEY__
CREDS_IV=__CREDS_IV__
